---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbJsonLd from '../../components/BreadcrumbJsonLd.astro';
import { siteConfig } from '../../site.config';

const title = "Request Received | Floyd's Plumbing";
const description = "Thanks for contacting Floyd's Plumbing. We will follow up by phone or email as soon as dispatch allows.";
---

<BaseLayout {title} {description}>
  <div class="relative border-b border-slate-200/80 bg-hero">
    <div class="bg-ripple pointer-events-none absolute inset-0 opacity-70" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 lg:px-8">
      <p class="text-xs font-black uppercase tracking-[0.25em] text-brand">Request received</p>
      <h1 class="font-display mt-4 text-4xl uppercase text-navy sm:text-5xl">We got your message</h1>
      <p class="mt-4 text-lg font-medium text-slate-700">
        Thanks for reaching out. A member of our team will follow up by phone or email as soon as dispatch allows.
      </p>
      <p class="mt-3 text-base text-slate-600">
        Need help right now? Call{' '}
        <a class="font-bold text-brand hover:underline" href={`tel:${siteConfig.phoneTel}`}>{siteConfig.phoneDisplay}</a>
        {siteConfig.emergency24_7 && (
          <>
            {' '}for emergencies (24/7).
          </>
        )}
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/"
          class="inline-flex items-center justify-center rounded-full bg-navy px-7 py-3 text-sm font-black uppercase tracking-wide text-white shadow-sm hover:bg-charcoal-dark"
        >
          Back to home
        </a>
        <a
          href="/services/"
          class="inline-flex items-center justify-center rounded-full border-2 border-navy bg-white px-7 py-3 text-sm font-black uppercase tracking-wide text-navy shadow-sm hover:bg-page-muted"
        >
          Browse services
        </a>
      </div>
    </div>
  </div>

  <BreadcrumbJsonLd
    crumbs={[
      { name: 'Home', item: '/' },
      { name: 'Contact', item: '/contact/' },
      { name: 'Thank you', item: '/contact/thanks/' }
    ]}
  />
</BaseLayout>
